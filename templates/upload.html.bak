{% extends "base.html" %}
{% load static %}

{% block title %}TestBrain - 测试用例上传{% endblock %}

{% block content %}
<div class="page-header">
    <h4>上传知识库文件</h4>
    <p>将项目文档上传至知识库，用于 AI 生成更贴合业务场景的测试用例</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" id="uploadForm" onsubmit="return handleSubmit(event)">
            {% csrf_token %}
            <div class="upload-area" id="uploadArea">
                <input type="file" name="single_file" id="single_file" style="display: none;" onchange="updateFileName(this)">
                <div class="upload-icon" style="margin-bottom: 12px;">
                    <i class="fas fa-cloud-upload-alt fa-3x" style="color: var(--text-tertiary);"></i>
                </div>
                <div style="margin-bottom: 20px;">
                    <button type="button" class="btn btn-primary file-input-button" id="selectFileBtn" onclick="document.getElementById('single_file').click()">
                        <i class="fas fa-folder-open"></i> 选择文件
                    </button>
                </div>
                <div style="color: var(--text-secondary); font-size: 14px; margin-bottom: 8px;">拖拽文件到此区域或点击选择文件</div>
                <div style="color: var(--text-tertiary); font-size: 13px;">支持 PDF、Word、Excel、Markdown、TXT 等多种格式</div>
                <div id="selected-file" class="selected-file" style="margin-top: 12px;"></div>
                <div id="uploadStatus" style="margin-top: 10px;"></div>
            </div>
            <div class="d-flex justify-content-center" style="margin-top: 20px;">
                <button type="submit" class="btn btn-success" id="submitBtn" style="padding: 10px 32px;">
                    <i class="fas fa-upload"></i> 上传并存储到知识库
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('single_file');
    let isUploading = false;

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
        uploadArea.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); }, false);
    });
    ['dragenter', 'dragover'].forEach(evt => {
        uploadArea.addEventListener(evt, () => { if (!isUploading) uploadArea.classList.add('dragover'); }, false);
    });
    ['dragleave', 'drop'].forEach(evt => {
        uploadArea.addEventListener(evt, () => { if (!isUploading) uploadArea.classList.remove('dragover'); }, false);
    });
    uploadArea.addEventListener('drop', function(e) {
        if (isUploading) return;
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            const dt = new DataTransfer();
            dt.items.add(files[0]);
            fileInput.files = dt.files;
            updateFileName(fileInput);
        }
    }, false);

    window.setUploadStatus = function(uploading) {
        isUploading = uploading;
        uploadArea.classList.toggle('uploading', uploading);
    };
});

function updateFileName(input) {
    const el = document.getElementById('selected-file');
    if (input.files && input.files[0]) {
        el.style.display = 'block';
        el.style.color = 'var(--success)';
        el.style.fontWeight = '500';
        el.innerHTML = '<i class="fas fa-file"></i> ' + input.files[0].name;
    } else {
        el.style.display = 'none';
    }
}

async function handleSubmit(event) {
    event.preventDefault();
    const form = event.target;
    const fileInput = form.querySelector('input[type="file"]');
    const submitBtn = document.getElementById('submitBtn');
    const selectFileBtn = document.getElementById('selectFileBtn');
    const statusDiv = document.getElementById('uploadStatus');

    if (!fileInput.files || !fileInput.files[0]) {
        statusDiv.innerHTML = '<span style="color: var(--danger);">请先选择要上传的文件</span>';
        return false;
    }

    submitBtn.disabled = true;
    selectFileBtn.disabled = true;
    if (window.setUploadStatus) window.setUploadStatus(true);
    statusDiv.innerHTML = '<span style="color: var(--text-secondary);"><i class="fas fa-spinner fa-spin"></i> 文件上传中，请稍候...</span>';

    try {
        const formData = new FormData(form);
        const resp = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value }
        });
        const result = await resp.json();
        if (result.success) {
            statusDiv.innerHTML = '<span style="color: var(--success); font-weight: 600;"><i class="fas fa-check-circle"></i> 上传成功！成功导入 ' + result.count + ' 条向量数据</span>';
            fileInput.value = '';
            document.getElementById('selected-file').style.display = 'none';
        } else {
            statusDiv.innerHTML = '<span style="color: var(--danger);">' + (result.error || '上传失败，请重试') + '</span>';
        }
    } catch (e) {
        statusDiv.innerHTML = '<span style="color: var(--danger);">上传过程中发生错误，请重试</span>';
    } finally {
        submitBtn.disabled = false;
        selectFileBtn.disabled = false;
        if (window.setUploadStatus) window.setUploadStatus(false);
    }
    return false;
}
</script>
{% endblock %}
